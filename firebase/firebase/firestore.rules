rules_version = '2';
// Toutes les lectures/écritures passent par le backend (Firebase Admin SDK, qui ignore ces règles).
// Les clients (React / Flutter) n'accèdent JAMAIS directement à Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
