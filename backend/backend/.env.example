PORT=5000
NODE_ENV=development
# URL du front web (CORS). Plusieurs origines possibles, séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Firebase Admin (choisir UNE des deux méthodes) ---
# Méthode 1 : chemin vers le fichier JSON du compte de service (NE PAS le commiter)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Méthode 2 : variables séparées
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Paiement ---
# mock = simulation locale | konnect = Konnect (mode test / preprod)
PAYMENT_MODE=mock
KONNECT_API_URL=https://api.preprod.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# URL publique de ce backend (pour le webhook Konnect, ex: URL ngrok)
BACKEND_PUBLIC_URL=http://localhost:5000
# Pages du front après paiement
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_FAIL_URL=http://localhost:3000/payment/fail
